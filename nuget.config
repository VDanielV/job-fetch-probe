<?xml version="1.0" encoding="utf-8"?>
<!-- This repository only needs public packages: use nuget.org alone, ignoring any other feeds set up for the user. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
