@page
@model IndexModel
@{
    ViewData["Title"] = "All jobs";
}

<h1>Jobs</h1>

@if (Model.Jobs is null)
{
    <p class="note">No database yet at <code>@Model.DatabasePath</code>. Run the console app first: it creates the database and fills it.</p>
    return;
}

<div class="pager">
    <span class="muted">@Model.Jobs.Total jobs · page @Model.Jobs.Page of @Model.Jobs.TotalPages</span>
    <nav>
        @if (Model.Jobs.Page > 1)
        {
            <a asp-page="/Index" asp-route-p="1">« First</a>
            <a asp-page="/Index" asp-route-p="@(Model.Jobs.Page - 1)">‹ Previous</a>
        }
        else
        {
            <span class="off">« First</span>
            <span class="off">‹ Previous</span>
        }
        @if (Model.Jobs.Page < Model.Jobs.TotalPages)
        {
            <a asp-page="/Index" asp-route-p="@(Model.Jobs.Page + 1)">Next ›</a>
            <a asp-page="/Index" asp-route-p="@Model.Jobs.TotalPages">Last »</a>
        }
        else
        {
            <span class="off">Next ›</span>
            <span class="off">Last »</span>
        }
    </nav>
</div>

<table>
    <thead>
        <tr><th>Title</th><th>Company</th><th>Location</th><th>Posted</th><th>Status</th></tr>
    </thead>
    <tbody>
        @foreach (var job in Model.Jobs.Jobs)
        {
            <tr>
                <td><a asp-page="/Job" asp-route-id="@job.JobId" asp-route-p="@Model.Jobs.Page">@(job.Title ?? job.JobId)</a></td>
                <td>@job.Company</td>
                <td>@job.Location</td>
                <td>@job.Posted</td>
                <td><span class="status @job.Status">@job.Status</span></td>
            </tr>
        }
    </tbody>
</table>
