@model JobFetchProbe.Web.Pages.FitView
@using JobFetchProbe.Web.Pages
@* The fit of the job in the pane: a score just made (POST api/JobFit), or the latest stored one, and the earlier ones. *@
@if (Model.Result is { } fit)
{
    <div class="fit-card @Model.Tone" data-fit-note="@Model.ArchiveNote" data-fit-job="@Model.JobId">
        <div class="fit-top">
            <span class="fit-decision @fit.Decision">@fit.Decision</span>
            <span class="fit-score">@fit.Fit<small> / 100</small></span>
            <span class="fit-meter" aria-hidden="true">
                <i style="width:@(fit.Fit)%"></i>
                <span class="fit-mark" style="left:40%"></span>
                <span class="fit-mark" style="left:60%"></span>
            </span>
        </div>
        <p class="fit-reason">
            @if (fit.HardSkip)
            {
                <span class="fit-hard">Hard skip</span>
            }
            @fit.Reason
        </p>
        @if (fit.MissingInformation.Count > 0)
        {
            <p class="fit-missing-title">Not stated in the job</p>
            <ul class="fit-missing">
                @foreach (var item in fit.MissingInformation)
                {
                    <li>@item</li>
                }
            </ul>
        }
        <div class="fit-foot">
            <span>
                @if (Model.Seconds >= 0)
                {
                    <text>Local model · @Model.Seconds s · saved</text>
                }
                else
                {
                    <text>Checked @IndexModel.When(fit.AssessedAt ?? DateTimeOffset.MinValue)@(Model.Model is not null ? " · " + Model.Model : "")</text>
                }
                @if (Model.OlderProfile)
                {
                    <span class="fit-older" title="Made with other Fit files (profile, policy or rubric) than the current ones">older profile</span>
                }
                @if (Model.ArchiveHint)
                {
                    <text> · the archive note below is filled in</text>
                }
            </span>
            <button type="button" class="fit-again" data-fit-again>Check again</button>
        </div>
        @if (Model.Earlier is { Count: > 0 } earlier)
        {
            <details class="fit-earlier">
                <summary>@(earlier.Count == 1 ? "1 earlier check" : $"{earlier.Count} earlier checks")</summary>
                <ol>
                    @foreach (var a in earlier)
                    {
                        <li>
                            <span class="fit-earlier-when">@IndexModel.When(a.AssessedAt)</span>
                            <span class="fit-num @FitView.ToneOf(a.Decision, a.HardSkip)">@a.Fit</span>
                            <span class="fit-earlier-decision">@a.Decision@(a.HardSkip ? " · hard skip" : "")</span>
                            @if (FitView.IsOlder(a, Model.CurrentProfile))
                            {
                                <span class="fit-older">older profile</span>
                            }
                            <span class="fit-earlier-reason">@a.Reason</span>
                        </li>
                    }
                </ol>
            </details>
        }
    </div>
}
else
{
    <div class="fit-card error" data-fit-job="@Model.JobId">
        <b>Couldn't score this job.</b> @Model.Error
        <button type="button" class="fit-again" data-fit-again>Try again</button>
    </div>
}
