@{
    var nav = ViewData["Nav"] as string ?? "Overview";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] · Job Fetch Probe</title>
    <link rel="icon" type="image/png" href="~/img/favicon.png">
    <link rel="stylesheet" href="~/css/site.css">
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <aside class="sidebar">
        <a class="brand" asp-page="/Index">
            <img src="~/img/logo.png" width="32" height="32" alt="">
            <span>
                <strong>Job Fetch Probe</strong>
                <small>Job postings collector</small>
            </span>
        </a>
        <nav class="menu" aria-label="Main">
            <a asp-page="/Index" title="Overview" class="@(nav == "Overview" ? "active" : null)" aria-current="@(nav == "Overview" ? "page" : null)">
                <svg viewBox="0 0 20 20" aria-hidden="true"><rect x="3" y="3" width="6" height="6" rx="1.5"/><rect x="11" y="3" width="6" height="6" rx="1.5"/><rect x="3" y="11" width="6" height="6" rx="1.5"/><rect x="11" y="11" width="6" height="6" rx="1.5"/></svg>
                <span>Overview</span>
            </a>
            <a asp-page="/Acquire" title="Acquire" class="@(nav == "Acquire" ? "active" : null)" aria-current="@(nav == "Acquire" ? "page" : null)">
                <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 3v9m0 0-3.5-3.5M10 12l3.5-3.5M4 14v1.5A1.5 1.5 0 0 0 5.5 17h9a1.5 1.5 0 0 0 1.5-1.5V14"/></svg>
                <span>Acquire</span>
            </a>
            <a asp-page="/Chat" title="Chat" class="@(nav == "Chat" ? "active" : null)" aria-current="@(nav == "Chat" ? "page" : null)">
                <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 5.5h12v7H9l-3 2.5V12.5H4z"/></svg>
                <span>Chat</span>
            </a>
        </nav>
    </aside>
    <main class="main">
        @RenderBody()
    </main>
    <script src="~/js/split.js" defer></script>
</body>
</html>
