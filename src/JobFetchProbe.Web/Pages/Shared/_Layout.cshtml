<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] · Jobs</title>
    <style>
        :root { color-scheme: light dark; --line: #8884; --muted: #888; --accent: #0a66c2; }
        body { font: 15px/1.5 system-ui, "Segoe UI", sans-serif; margin: 0 auto; max-width: 1100px; padding: 1.5rem; }
        h1 { font-size: 1.5rem; margin: 0 0 .25rem; }
        a { color: var(--accent); text-decoration: none; }
        a:hover { text-decoration: underline; }
        .muted { color: var(--muted); }
        table { border-collapse: collapse; width: 100%; }
        th, td { border-bottom: 1px solid var(--line); padding: .45rem .5rem; text-align: left; vertical-align: top; }
        th { font-weight: 600; white-space: nowrap; }
        tbody tr:hover { background: #8881; }
        .pager { display: flex; gap: .75rem; align-items: center; justify-content: space-between; margin: 1rem 0; }
        .pager nav { display: flex; gap: .5rem; }
        .pager a, .pager span.off { border: 1px solid var(--line); border-radius: 6px; padding: .2rem .6rem; }
        .pager span.off { color: var(--muted); }
        .status { border-radius: 999px; font-size: .8rem; padding: .05rem .55rem; white-space: nowrap; border: 1px solid currentColor; }
        .status.Read { color: #1a7f37; } .status.Pending { color: var(--muted); }
        .status.Blocked, .status.Failed { color: #cf222e; } .status.Gone { color: var(--muted); text-decoration: line-through; }
        dl { display: grid; grid-template-columns: max-content 1fr; gap: .3rem 1.25rem; margin: 1.25rem 0; }
        dt { color: var(--muted); }
        dd { margin: 0; }
        .description { white-space: pre-wrap; border-top: 1px solid var(--line); padding-top: 1rem; }
        .note { border: 1px solid var(--line); border-radius: 8px; padding: 1rem; }
    </style>
</head>
<body>
    @RenderBody()
</body>
</html>
