@page
@model AcquireModel
@using JobFetchProbe.Models.Journal
@{
    ViewData["Title"] = "Acquire";
    ViewData["Nav"] = "Acquire";
    var v = Model.View;
    var busy = Model.Refresh;
}

@section Head {
    @if (Model.Refresh)
    {
        <meta http-equiv="refresh" content="@AcquireModel.RefreshSeconds">
    }
}

<header class="page-head">
    <div>
        <h1>Acquire</h1>
        <p>Bring new jobs into the database.</p>
    </div>
</header>

<div class="content">
    <div class="acquire">
        @if (Model.Banner is { } banner && !(banner.Kind == "error" && Model.Error is not null))
        {
            <partial name="_Banner" model="banner" />
        }

        @if (Model.ShowProgress)
        {
            <details class="howto">
                <summary>How it works</summary>
                <partial name="_AcquireExplanation" />
            </details>
        }
        else
        {
            <section class="explain">
                <partial name="_AcquireExplanation" />
            </section>
        }

        <div class="launch">
            <div class="launch-buttons">
                <form method="post">
                    <button class="start" type="submit" disabled="@(busy ? "disabled" : null)">
                        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M6 4.5v11a1 1 0 0 0 1.5.86l9-5.5a1 1 0 0 0 0-1.72l-9-5.5A1 1 0 0 0 6 4.5z"/></svg>
                        @(busy ? "Running…" : "Start acquisition")
                    </button>
                </form>
                @if (Model.CanStop)
                {
                    <form method="post" asp-page-handler="Stop">
                        <input type="hidden" name="since" value="@Model.Since">
                        <button class="stop" type="submit" disabled="@(Model.StopRequested ? "disabled" : null)">
                            <svg viewBox="0 0 20 20" aria-hidden="true"><rect x="5" y="5" width="10" height="10" rx="2"/></svg>
                            @(Model.StopRequested ? "Stopping…" : "Stop")
                        </button>
                    </form>
                }
            </div>
            <div>
                <p class="small-label">@(Model.ShowProgress ? "Acquisition" : "Last acquisition")</p>
                <p class="lastrun">
                    @if (v is null)
                    {
                        <span>unknown (the API cannot answer)</span>
                    }
                    else if (v.IsStarting)
                    {
                        <span class="status Starting">Starting</span><span>waiting for it to appear in the journal</span>
                    }
                    else if (v.Listing is null)
                    {
                        <span>No acquisition yet.</span>
                    }
                    else if (v.IsRunning)
                    {
                        <span class="status Running">Running</span><span>since @v.When(v.StartedAt)</span>
                    }
                    else
                    {
                        <span class="status @v.StateText">@v.StateText</span>
                        <span>@v.When(v.Details?.FinishedAt ?? v.Listing.FinishedAt ?? v.Listing.LastSeenAt)</span>
                        @if (!Model.ShowProgress)
                        {
                            <span> · @Short(v.Details?.Message ?? v.Listing.Message) · <a class="link" asp-page="/Index">see the jobs</a></span>
                        }
                    }
                </p>
            </div>
        </div>

        @if (Model.ShowProgress && v is not null)
        {
            <section class="progress-pane" aria-live="polite">
                <div class="pp-head">
                    <h2>
                        @if (busy)
                        {
                            <span class="pulse" aria-hidden="true"></span>
                        }
                        @v.Heading
                    </h2>
                    @if (busy)
                    {
                        <small>updated @v.Now.ToLocalTime().ToString("HH:mm:ss") · refreshes every @AcquireModel.RefreshSeconds s</small>
                    }
                    else
                    {
                        <a class="link" asp-page="/Acquire">Close</a>
                    }
                </div>

                @if (v.EndBanner is { } end)
                {
                    <div class="pp-banner"><partial name="_Banner" model="end" /></div>
                }

                <nav class="tabs" aria-label="Acquisition">
                    <a class="@(Model.Tab == AcquireModel.TabProgress ? "on" : null)" asp-page="/Acquire" asp-route-tab="@AcquireModel.TabProgress" asp-route-since="@Model.Since" asp-route-stopping="@(Model.StopRequested ? "true" : null)">Progress</a>
                    <a class="@(Model.Tab == AcquireModel.TabRun ? "on" : null)" asp-page="/Acquire" asp-route-tab="@AcquireModel.TabRun" asp-route-since="@Model.Since" asp-route-stopping="@(Model.StopRequested ? "true" : null)">Whole run (@v.WholeRun.Count)</a>
                    <a class="@(Model.Tab == AcquireModel.TabSummary ? "on" : null)" asp-page="/Acquire" asp-route-tab="@AcquireModel.TabSummary" asp-route-since="@Model.Since" asp-route-stopping="@(Model.StopRequested ? "true" : null)">Summary</a>
                </nav>

                @if (Model.Tab == AcquireModel.TabRun)
                {
                    <partial name="_AcquireWholeRun" model="v" />
                }
                else if (Model.Tab == AcquireModel.TabSummary)
                {
                    <partial name="_AcquireSummary" model="v" />
                }
                else
                {
                    <partial name="_AcquireProgress" model="v" />
                }

                <div class="pp-foot">
                    <a class="link" asp-page="/Index">See the jobs in Overview</a>
                    @if (v.Listing is not null)
                    {
                        <span>·</span>
                        <span>Journal: step 1 run @v.Listing.RunId</span>
                        @if (v.Details is not null)
                        {
                            <span>step 2 run @v.Details.RunId</span>
                        }
                    }
                </div>
            </section>
        }

        @if (Model.Error is { } error)
        {
            <partial name="_ErrorPane" model="error" />
        }
    </div>
</div>

@functions {
    private static string Short(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            return string.Empty;
        }
        if (text.Length <= 110)
        {
            return text;
        }
        return text[..109] + "…";
    }
}
