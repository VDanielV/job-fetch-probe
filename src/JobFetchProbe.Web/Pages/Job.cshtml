@page "/jobs/{id}"
@model JobModel
@{
    var job = Model.Job!;
    ViewData["Title"] = job.Title ?? job.JobId;
}

<p><a asp-page="/Index" asp-route-p="@Model.FromPage">← All jobs</a></p>

<h1>@(job.Title ?? job.JobId)</h1>
<p class="muted">@string.Join(" · ", new[] { job.Company, job.Location }.Where(s => !string.IsNullOrWhiteSpace(s)))</p>
<p><span class="status @job.Status">@job.Status</span> &nbsp; <a href="@job.Url" target="_blank" rel="noopener noreferrer">Open the job page ↗</a></p>

<dl>
    <dt>Job ID</dt><dd>@job.JobId</dd>
    @if (job.Posted is not null) { <dt>Posted</dt><dd>@job.Posted</dd> }
    @if (job.EmploymentType is not null) { <dt>Employment type</dt><dd>@job.EmploymentType</dd> }
    @foreach (var detail in job.Details)
    {
        <dt>@detail.Label</dt><dd>@detail.Value</dd>
    }
    <dt>First seen</dt><dd>@JobModel.When(job.FirstSeenAt)</dd>
    @if (job.RetrievedAt is { } read) { <dt>Description read</dt><dd>@JobModel.When(read)</dd> }
    @if (job.LastError is not null)
    {
        <dt>Last attempt</dt><dd>@(job.LastAttemptAt is { } at ? JobModel.When(at) : "")</dd>
        <dt>Last error</dt><dd>@job.LastError</dd>
    }
</dl>

@if (string.IsNullOrWhiteSpace(job.Description))
{
    <p class="note">No description yet. The console app reads it on its next run (status Pending, Blocked or Failed), unless the page is gone.</p>
}
else
{
    <div class="description">@job.Description</div>
}
