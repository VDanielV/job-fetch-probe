<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- RESTful API over the jobs database: reads jobs and the journal, starts acquisitions (JobFetcher). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Content Update="Fit\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JobFetchProbe.Services\JobFetchProbe.Services.csproj" />
    <!-- Only for Program.cs, which wires Data and Infrastructure into DI. Controllers use Services types only. -->
    <ProjectReference Include="..\JobFetchProbe.Data\JobFetchProbe.Data.csproj" />
    <ProjectReference Include="..\JobFetchProbe.Infrastructure\JobFetchProbe.Infrastructure.csproj" />
  </ItemGroup>

</Project>
