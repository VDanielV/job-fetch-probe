{
  "Paths": {
    "DataRoot": "C:\\Code\\job-fetcher\\job-fetch-probe-data"
  },
  "FetchJobDetails": {
    "DelaySeconds": 5,
    "CircuitBreaker": {
      "FailureThreshold": 3,
      "CooldownSeconds": 300,
      "MaxCooldownSeconds": 1800,
      "StopAfterOpenings": 3
    }
  },
  "HttpClient": {
    "TimeoutSeconds": 20,
    "UserAgent": "JobFetchProbe/0.3 (personal study project)",
    "HandlerLifetimeMinutes": 5
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*"
}
