{
  "Paths": {
    "DataRoot": "C:\\Code\\job-fetcher\\job-fetch-probe-data"
  },
  "Storage": {
    "Provider": "Sqlite"
  },
  "Inbox": {
    "ProcessOnStart": true
  },
  "Details": {
    "DelaySeconds": 5,
    "RunAfterInbox": true,
    "CircuitBreaker": {
      "FailureThreshold": 3,
      "CooldownSeconds": 300,
      "MaxCooldownSeconds": 1800,
      "StopAfterOpenings": 3
    }
  },
  "Search": {
    "DefaultUrl": "https://es.linkedin.com/jobs/.net-empleos-valencia"
  },
  "HttpClient": {
    "TimeoutSeconds": 20,
    "UserAgent": "JobFetchProbe/0.3 (personal study project)",
    "HandlerLifetimeMinutes": 5
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    }
  }
}
